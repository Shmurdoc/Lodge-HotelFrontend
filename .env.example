# Supabase configuration for frontend development
# Copy this file to .env (NOT committed) and fill in real values.
#
# Example:
# VITE_SUPABASE_URL=https://your-project-ref.supabase.co
# VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR...

VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here

# Development note:
# - The anon key is intended for client-side usage (public) but still rotate it if leaked.
# - Never place the Supabase "service_role" key or any other secret in the client (.env or code).
# - For server-side operations that require elevated privileges, use a backend-only secret store.